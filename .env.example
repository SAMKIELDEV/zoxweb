# Where the Zox backend answers. Production: https://zoxapi.samkiel.tech
ZOX_BACKEND_URL=http://localhost:3000
SAMKIEL_ID_URL=https://id.samkiel.tech
# Set APP_ORIGIN to the public dashboard origin in production:
# https://zox.samkiel.tech
APP_ORIGIN=http://localhost:3002

# Sign-in is SAMKIEL ID's: people sign in at the accounts site, which sets
# the session cookies for every samkiel.tech site. The dashboard keeps no
# session of its own, so it needs no Redis and no database.
#
# Only for a local accounts site (the same variable kiv uses). Read when the
# site is built. Default: https://accounts.samkiel.tech
# NEXT_PUBLIC_SAMKIEL_ACCOUNTS_URL=http://localhost:3001

# ─── Public landing page ───
# These are read when the site is BUILT and end up in the page, so they
# hold nothing secret. Change one, then rebuild.
#
# Zox's WhatsApp number: digits only, country code first (for example
# 2348012345678). The landing page builds its chat links from it. Left
# empty, those buttons go to sign-in instead, so they are never dead.
NEXT_PUBLIC_ZOX_WHATSAPP_NUMBER=+1 (555) 177-6300
# Optional profile links for the landing page footer (https only).
# An empty one hides that icon.
NEXT_PUBLIC_ZOX_X_URL=https://zox.samkiel.com
NEXT_PUBLIC_ZOX_INSTAGRAM_URL=
